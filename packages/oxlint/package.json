{
	"name": "@standard-config/oxlint",
	"version": "2.4.0",
	"description": "Curated Oxlint config with sensible defaults",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"homepage": "https://sconfig.org/oxlint",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/standard-config/oxlint.git",
		"directory": "packages/oxlint"
	},
	"keywords": [
		"eslint-config-xo",
		"eslint-config-xo-typescript",
		"linter",
		"oxc",
		"oxlint",
		"oxlint-config",
		"oxlint-tsgolint",
		"react",
		"standard-config",
		"standard-config-oxlint",
		"stylistic",
		"type-aware",
		"typescript",
		"vite+",
		"vite-plus",
		"xo"
	],
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=22"
	},
	"peerDependencies": {
		"@standard-config/oxlint-react": "^2.0.1",
		"@standard-config/oxlint-stylistic": "^2.0.1",
		"oxlint": "^1.73.0"
	},
	"peerDependenciesMeta": {
		"@standard-config/oxlint-react": {
			"optional": true
		},
		"@standard-config/oxlint-stylistic": {
			"optional": true
		}
	},
	"devDependencies": {
		"@standard-config/tsconfig": "catalog:",
		"@standard-config/utilities": "workspace:*",
		"oxlint": "catalog:",
		"publint": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"scripts": {
		"build": "vp pack",
		"prepack": "pnpm build",
		"test": "vp test",
		"typecheck": "tsc --noEmit"
	}
}
